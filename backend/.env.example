DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pulseboard
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
REDIS_HOST=localhost
REDIS_PORT=6379
# OIDC (Keycloak by default — see docker/keycloak/pulseboard-realm.json)
AUTH_ISSUER_URL=http://localhost:8080/realms/pulseboard
AUTH_AUDIENCE=pulseboard-api
AUTH_ROLES_CLAIM=realm_access.roles
# AUTH_JWKS_URI=   # optional, discovered from the issuer when empty
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
